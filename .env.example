# Copy to `.env` and fill in keys for external AI providers (optional).
# Built-in recommendations work without any keys.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar
